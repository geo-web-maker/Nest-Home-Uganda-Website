{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://admin.bhcug.com/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.bhcug.com/:path*",
      "permanent": true
    }
  ]
}
