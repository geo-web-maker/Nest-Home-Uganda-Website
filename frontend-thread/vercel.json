{
  "rewrites": [
    { "source": "/agreement/:path*", "destination": "/agreement-shell.html" },
    { "source": "/a/:path*", "destination": "/agreement-shell.html" },
    { "source": "/verify/:path*", "destination": "/agreement-shell.html" },
    {
      "source": "/api/:path*",
      "destination": "https://multi-site-hosting.onrender.com/nest/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://admin.bhcug.com/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.bhcug.com/:path*",
      "permanent": true
    }
  ]
}
