{
  "name": "nest-home-thread",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; every other path is served straight from the static build.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Backend base URL including its mount prefix, no trailing slash.
    "BACKEND_URL": "https://multi-site-hosting.onrender.com/nest"
  }
}
