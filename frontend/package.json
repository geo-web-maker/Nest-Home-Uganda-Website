{
  "name": "nest-home-care-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite-react-ssg build && node scripts/make-admin-shell.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:types": "bash ../scripts/gen-types.sh",
    "gen:types:ts": "openapi-typescript src/types/openapi.json -o src/types/api.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:admin-native": "tsc --noEmit && vite build --config vite.admin-native.config.ts",
    "test:a11y": "playwright test e2e/care-a11y.spec.ts",
    "test:responsive": "playwright test e2e/care-responsive.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-query": "5.104.4",
    "i18next": "26.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.0",
    "react-router-dom": "6.30.6",
    "vite-react-ssg": "0.9.2",
    "zod": "4.6.7",
    "@capacitor/core": "7.4.3",
    "@capacitor/push-notifications": "7.0.3",
    "capacitor-secure-storage-plugin": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "@capacitor/cli": "7.4.3",
    "dexie": "4.0.11",
    "fake-indexeddb": "6.2.4",
    "@axe-core/playwright": "4.10.2"
  }
}
