{
  "rewrites": [
    {
      "source": "/agreement/:path*",
      "destination": "/agreement-shell.html"
    },
    {
      "source": "/a/:path*",
      "destination": "/agreement-shell.html"
    },
    {
      "source": "/verify/:path*",
      "destination": "/agreement-shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://admin.bhcug.com/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.bhcug.com/:path*",
      "permanent": true
    }
  ]
}
