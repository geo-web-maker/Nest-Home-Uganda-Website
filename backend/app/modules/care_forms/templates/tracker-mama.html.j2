{% extends "tracker-base.html.j2" %}{% block title %}Mama weekly tracker{% endblock %}{% block notes_h %}11mm{% endblock %}
{% block body %}<div class="tt"><b>MAMA WEEKLY TRACKER</b><div>One page per week for Mama only · postnatal recovery · morning and evening</div></div>
<table class="nm"><tr><td><i>Mama name:</i> <b>{{ patient.name }}</b></td><td><i>Baby name:</i> <b>{{ partner.name }}</b></td></tr><tr><td><i>Nurse:</i> <b>{{ author.name }}</b> · {{ author.registration_line }}</td><td><i>Week:</i> <b>{{ week.label }}</b></td></tr></table>
<h3>1. Daily log · morning and evening</h3>
<table class="g"><thead><tr><th style="width:24mm">DAY</th><th style="width:14mm">TEMP C</th><th style="width:15mm">PAIN 0-10</th><th style="width:24mm">BREAST CHECK</th><th style="width:30mm">BLEEDING / WOUND</th><th style="width:31mm">MEALS + WATER</th><th style="width:34mm">SLEEP / MOOD</th><th style="width:10mm">INIT.</th></tr></thead><tbody>
{% for r in rows %}<tr style="height:7.4mm"><td class="d{% if r.highlight %} fd{% endif %}"><b>{{ r.day }}</b> {{ r.slot }}</td>{% for c in r.cells %}<td{% if r.filled %} class="f"{% endif %}>{{ c }}</td>{% endfor %}</tr>{% endfor %}
</tbody></table>
<h3>2. Today's care · one box per day</h3>
<table class="g"><thead><tr><th style="width:44mm;text-align:left;padding-left:2mm">TODAY'S CARE</th>{% for d in week.days %}<th>{{ d }}</th>{% endfor %}</tr></thead><tbody>
{% for c in care_rows %}<tr style="height:7mm"><td class="d">{{ c.label }}</td>{% for v in c.cells %}<td{% if v %} class="f"{% endif %} style="font-size:6.5pt">{{ v }}</td>{% endfor %}</tr>{% endfor %}
</tbody></table>
<h3>3. Notes / concerns</h3><div class="nt">{% for n in notes %}<div><b>{{ n.day|upper }}</b> &nbsp;{{ n.text }}</div>{% endfor %}</div>
<div class="call m"><b>CALL {{ org.short_name|upper }} IF:</b><br>Temp above 37.5 C, heavy bleeding, or bad smell · Severe pain, breast very hard or red, or wound opening<br>Feeling very sad, anxious, or not sleeping at all</div>{% endblock %}
