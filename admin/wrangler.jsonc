{
  "name": "nest-home-admin",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "admin.bhcug.com/*", "zone_name": "bhcug.com" }
  ],
  "vars": {
    "BACKEND_URL": "https://multi-site-hosting.onrender.com/nest"
  }
}
