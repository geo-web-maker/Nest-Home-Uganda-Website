# Admin frontend build-time settings. Use the actual deployed origins (no trailing slash).
VITE_API_URL=https://YOUR-MULTI-HOST-DOMAIN/nest
VITE_NURSE_APP_URL=https://YOUR-NURSE-APP-DOMAIN
VITE_SHOW_PULL_SSO=true
VITE_NURSE_ANDROID_PACKAGE=ug.nesthomecare.nurse

# Native pull handoff remains user-initiated from the login screen.
# The server's /auth/app-access response remains authoritative for permissions.
