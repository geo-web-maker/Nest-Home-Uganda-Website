# Copy to .env.production (or set as a build variable on Cloudflare/Vercel).
# Without this the nurse app posts to its own static host and gets 405 on login.
# Multi-host: https://<your-multi-host-domain>/nest
VITE_API_URL=https://YOUR-MULTI-HOST-DOMAIN/nest

# Origin ONLY of the S3/R2 endpoint that presigned attachment uploads PUT to (no bucket path).
# Without it the nurse CSP blocks uploads: "Failed to fetch" on every attachment.
# Also add https://nurse.bhcug.com to that bucket's CORS AllowedOrigins (methods PUT, GET; header Content-Type).
VITE_MAIL_STORAGE_URL=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
