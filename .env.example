# Existing application configuration. Add real values only in the hosting provider's secret store.
APP_ENV=development
MONGODB_URI=
MONGODB_DB=nest_home_care
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=
FRONTEND_URL=
# Optional deploy hook (Cloudflare Pages or Vercel) that rebuilds the pre-rendered public site.
SITE_REBUILD_HOOK_URL=
SITE_REBUILD_DEBOUNCE_SECONDS=300
BUSINESS_EMAIL=
IP_HASH_SALT=
SCHEDULER_ENABLED=true
VITE_API_URL=

# Existing S3-compatible media storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_KEY=
S3_SECRET=

# Nurse/care data. Keep both MongoDB databases external and private.
CARE_MONGODB_URI=
CARE_MONGODB_DB=

# Cloudinary photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase push. Fake sender is safe for local development and CI.
PUSH_SENDER=fake
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_JSON_B64=
PUSH_TTL_CRITICAL_SECONDS=14400
PUSH_TTL_NORMAL_SECONDS=86400
PUSH_CHANNEL_CRITICAL=nest_critical
PUSH_CHANNEL_NORMAL=nest_normal
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID_NURSE=
FIREBASE_APP_ID_ADMIN=
CAP_APP_ID_NURSE=ug.nesthomecare.nurse
CAP_APP_ID_ADMIN=ug.nesthomecare.admin

# Backblaze B2 backup values. These must never be committed with real values.
B2_ENDPOINT=
B2_KEY=
B2_SECRET=
BACKUP_BUCKET=
BACKUP_PASSPHRASE=
BACKUP_SOURCE_URI_PRIMARY=
BACKUP_SOURCE_URI_CARE=
BACKUP_RESTORE_URI=

# BEGIN CARE SETTINGS
# Care settings override registry defaults. Empty values fall through to the next layer.
# CARE_APP_LOCATION_DISCLOSURE: app.location_disclosure; type=text; default=''; required_before_go_live=Yes
CARE_APP_LOCATION_DISCLOSURE=
# CARE_MODULE_ENABLED: care.module_enabled; type=boolean; default=False; required_before_go_live=Yes
CARE_MODULE_ENABLED=
# CARE_CONSENT_LOCATION_TEXT: consent.location_text; type=text; default=''; required_before_go_live=Yes
CARE_CONSENT_LOCATION_TEXT=
# CARE_CONSENT_LOCATION_VERSION: consent.location_version; type=text; default=''; required_before_go_live=Yes
CARE_CONSENT_LOCATION_VERSION=
# CARE_FIELD_MAX_ACCURACY_M: field.max_accuracy_m; type=integer; default=100; required_before_go_live=Yes
CARE_FIELD_MAX_ACCURACY_M=
# CARE_GEO_DEFAULT_RADIUS_M: geo.default_radius_m; type=integer; default=150; required_before_go_live=Yes
CARE_GEO_DEFAULT_RADIUS_M=
# CARE_GEO_MAX_ACCURACY_M: geo.max_accuracy_m; type=integer; default=100; required_before_go_live=Yes
CARE_GEO_MAX_ACCURACY_M=
# CARE_OPS_DATABASE_OFF_M0: ops.database_off_m0; type=boolean; default=False; required_before_go_live=Yes
CARE_OPS_DATABASE_OFF_M0=
# CARE_OPS_DATABASE_TIER_OK: ops.database_tier_ok; type=boolean; default=False; required_before_go_live=Yes
CARE_OPS_DATABASE_TIER_OK=
