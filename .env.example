# Copy to .env (never commit .env). Values are empty or dummy on purpose.

# --- Backend core (spec 9.9) ---
APP_ENV=development
MONGODB_URI=
MONGODB_DB=nest_home_care
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=
FRONTEND_URL=
TZ=Africa/Kampala
PORT=8000
IP_HASH_SALT=
TURNSTILE_SECRET=
SENTRY_DSN=
SEO_INDEX=false
VERCEL_DEPLOY_HOOK_URL=

# --- Storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_KEY=
S3_SECRET=

# --- Email (provider settings; exact provider not chosen yet) ---
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_API_KEY=

# --- SMS: MamboSMS (BUILDER_INSTRUCTIONS Section 13) ---
SMS_PROVIDER=console
MAMBOSMS_BASE_URL=https://api-mongolia.mambosms.com/v1
MAMBOSMS_API_KEY=

# --- Alert contacts (seed values for admin settings; comma separated) ---
ALERT_EMAILS=
ALERT_PHONES=

# --- First superadmin (seed script fails if empty) ---
FIRST_SUPERADMIN_EMAIL=
FIRST_SUPERADMIN_PASSWORD=

# --- Test infrastructure (set when Docker is unavailable) ---
TEST_MONGODB_URI=
TEST_S3_ENDPOINT=

# --- Frontend (Vite) ---
VITE_API_URL=
VITE_SITE_URL=

# --- Added in S2 ---
TRUST_PROXY=false
COOKIE_SAMESITE=lax

# --- Added in S4 (enquiries, SMS, reminders; stand-ins until the settings module exists) ---
MAMBOSMS_BASE_URL=https://api-mongolia.mambosms.com/v1
SMS_SENDER_ID=NestCare
SMS_MESSAGE_CATEGORY=info
SMS_DAILY_LIMIT=200
SMS_STAFF_ENABLED=true
SMS_VISITOR_ENABLED=true
BUSINESS_WHATSAPP=256787499988
NOTIFY_REMINDER_MINUTES=30
NOTIFY_HOURS_FROM=07:00
NOTIFY_HOURS_TO=20:00
SCHEDULER_ENABLED=true
