+import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { afterEach, describe, expect, it } from 'vitest';
+import { ThemeSwitch } from './ThemeSwitch';
+
+afterEach(() => { window.localStorage.clear(); document.documentElement.removeAttribute('data-theme'); });
+
+describe('ThemeSwitch', () => {
+  it('exposes an accessible group and reflects the current choice', async () => {
+    render(<ThemeSwitch label="Theme" lightLabel="Light" darkLabel="Dark" />);
+    const group = screen.getByRole('group', { name: 'Theme' });
+    expect(group).toBeInTheDocument();
+    const light = screen.getByRole('button', { name: 'Light' });
+    const dark = screen.getByRole('button', { name: 'Dark' });
+    expect(light).toHaveAttribute('aria-pressed', 'true');
+    await userEvent.click(dark);
+    expect(dark).toHaveAttribute('aria-pressed', 'true');
+    expect(light).toHaveAttribute('aria-pressed', 'false');
+    expect(window.localStorage.getItem('nest-theme')).toBe('dark');
+    expect(document.documentElement.dataset.theme).toBe('dark');
+  });
+});
diff --git a/frontend/src/components/ui/ThemeSwitch.tsx b/frontend/src/components/ui/ThemeSwitch.tsx
--- /dev/null
+++ b/frontend/src/components/ui/ThemeSwitch.tsx
@@ -0,0 +1,52 @@
+import { useState } from 'react';
+import { getTheme, setTheme, type Theme } from '../../lib/theme';
+import styles from './ThemeSwitch.module.css';
+
+type ThemeSwitchProps = {
+  label: string;
+  lightLabel: string;
+  darkLabel: string;
+  compact?: boolean;
+  inverse?: boolean;
+};
+
+/** Explicit light/dark preference. Does not follow OS colour-scheme changes. */
+export function ThemeSwitch({
+  label,
+  lightLabel,
+  darkLabel,
+  compact = false,
+  inverse = false,
+}: ThemeSwitchProps) {
+  const [theme, updateTheme] = useState<Theme>(() => getTheme());
+  const choose = (next: Theme) => {
+    setTheme(next);
+    updateTheme(next);
+  };
+
+  return (
+    <div
+      className={`${styles.switch} ${compact ? styles.compact : ''} ${inverse ? styles.inverse : ''}`}
+      role="group"
+      aria-label={label}
+    >
+      <span className={styles.label}>{label}</span>
+      <button
+        type="button"
+        className={styles.option}
+        aria-pressed={theme === 'light'}
+        onClick={() => choose('light')}
+      >
+        {lightLabel}
+      </button>
+      <button
+        type="button"
+        className={styles.option}
+        aria-pressed={theme === 'dark'}
+        onClick={() => choose('dark')}
+      >
+        {darkLabel}
+      </button>
+    </div>
+  );
+}
