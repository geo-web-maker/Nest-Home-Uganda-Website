diff --git a/nurse/src/styles.css b/nurse/src/styles.css
index f67f27f..85e8126 100644
--- a/nurse/src/styles.css
+++ b/nurse/src/styles.css
@@ -230,3 +230,47 @@ small, .muted, .hint { color: var(--mut); }
 .theme-choice { display: flex; flex-wrap: wrap; gap: 0.65rem; }
 .theme-choice button { flex: 1 1 7rem; min-height: 48px; }
