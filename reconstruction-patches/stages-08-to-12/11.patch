 .native-options { display: grid; gap: .35rem; margin-top: .7rem; }
 .native-options span { display: grid; min-height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 999px; background: var(--surf); color: var(--mut); font-size: .72rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
+
+
+/* Stage 11: Today cards, connection states and unscheduled visit sheet. */
+.connection-banner { grid-template-columns: auto 1fr; }
+.connection-banner strong { grid-column: 1 / -1; }
+.connection-banner > a { justify-self: start; padding-top: .15rem; font-size: .82rem; }
+.adhoc-launch button { width: auto; min-height: 44px; padding: .45rem .55rem .45rem 1rem; border: 0; border-radius: 999px; background: var(--mint); color: var(--ink); }
+.adhoc-launch button span { width: 2rem; height: 2rem; display: grid; place-items: center; margin-left: .35rem; border-radius: 50%; background: color-mix(in srgb, var(--ink) 8%, transparent); }
+.adhoc-sheet { padding-top: .7rem; }
+.sheet-handle { width: 40px; height: 4px; margin: 0 auto 1rem; border-radius: 99px; background: var(--line); }
+.adhoc-sheet h2 { margin-bottom: .25rem; font-family: var(--serif); font-size: 1.4rem; }
+.adhoc-sheet > p { margin-top: 0; color: var(--mut); }
+.adhoc-options { display: grid; }
+.adhoc-options label { display: grid; grid-template-columns: 1.5rem 1fr; align-items: center; min-height: 50px; margin: 0; border-bottom: 1px solid var(--line); font-weight: 500; }
+.adhoc-options input { width: 1.35rem; min-height: 1.35rem; margin: 0; accent-color: var(--leaf); }
+.adhoc-sheet .notice.info { margin-top: .7rem; border: 0; border-radius: .75rem; background: color-mix(in srgb, var(--leaf) 12%, var(--mint)); color: var(--leaf); }
+.adhoc-sheet .sheet-actions { display: grid; grid-template-columns: 1fr; }
+.adhoc-sheet .sheet-actions button:first-child { justify-content: space-between; min-height: 56px; border-radius: 999px; background: var(--gold); color: var(--on-gold); }
+.adhoc-sheet .sheet-actions button:first-child span { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--on-gold) 12%, transparent); }
+@media (min-width: 820px) { .adhoc-sheet { width: min(540px, 92%); } }
