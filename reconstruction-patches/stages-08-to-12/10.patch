+
+
+/* Stage 10: sign-in, disclosure and location explanation. */
+.login-screen { width: min(100%, 420px); margin: 1.2rem auto 0; display: grid; gap: .75rem; }
+.login-mark { width: 3.4rem; height: 3.4rem; display: grid; place-items: center; margin-left: .4rem; border-bottom: 3px solid var(--gold); border-radius: 50%; color: var(--gold); font-size: 1.35rem; }
+.login-panel { padding: 1.45rem; }
+.login-panel h1 { margin: 0; font-family: var(--serif); font-size: clamp(1.8rem, 7vw, 2.2rem); }
+.login-subtitle { margin: .2rem 0 1.15rem; color: var(--mut); }
+.login-panel form button { width: 100%; justify-content: space-between; min-height: 56px; padding-left: 1.4rem; border-radius: 999px; background: var(--gold); color: var(--on-gold); }
+.login-panel form button span { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--on-gold) 12%, transparent); }
+.forgot-password { display: grid; gap: .1rem; margin: 1rem 0 0; text-align: center; color: var(--mut); }
+.forgot-password small { color: var(--mut); }
+.onboarding-panel { max-width: 560px; margin-inline: auto; }
+.onboarding-panel h1 { font-family: var(--serif); }
+.onboarding-intro { margin-top: -.35rem; color: var(--mut); }
+.disclosure-card { padding: 1rem; }
+.disclosure-card > .eyebrow:empty { display: none; }
+.disclosure-items { display: grid; }
+.disclosure-item { display: grid; grid-template-columns: 1.5rem 1fr; gap: .55rem; padding: .75rem 0; border-bottom: 1px solid var(--line); }
+.disclosure-item:last-child { border-bottom: 0; }
+.disclosure-item strong { color: var(--ink); }
+.disclosure-item p { grid-column: 2; margin: -.25rem 0 0; color: var(--mut); }
+.disclosure-card > button { width: 100%; margin-top: .8rem; }
+.placeholder { padding: .85rem .9rem; border: 1px dashed var(--gold); border-radius: 14px; background: color-mix(in srgb, var(--gold) 7%, transparent); color: var(--mut); font-style: italic; }
+.privacy-notice { margin: 0; }
+.check-row { min-height: 48px; margin: .2rem 0; }
+.check-row input { width: 1.35rem; height: 1.35rem; min-height: 1.35rem; margin-top: .2rem; }
+.onboarding-panel > button { width: 100%; min-height: 56px; justify-content: space-between; border-radius: 999px; background: var(--gold); color: var(--on-gold); }
+.onboarding-panel > button span { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--on-gold) 12%, transparent); }
+.location-explanation { text-align: center; }
+.location-icon { width: 5rem; height: 5rem; display: grid; place-items: center; margin: .2rem auto .3rem; border-radius: 50%; background: var(--mint); color: var(--leaf); font-size: 2.1rem; }
+.location-explanation .disclosure-card { text-align: left; }
+.native-prompt { text-align: center; }
+.native-prompt h2 { font-family: var(--sans); font-size: 1rem; }
+.native-options { display: grid; gap: .35rem; margin-top: .7rem; }
+.native-options span { display: grid; min-height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 999px; background: var(--surf); color: var(--mut); font-size: .72rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
