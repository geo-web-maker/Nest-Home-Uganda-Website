diff --git a/nurse/src/styles.css b/nurse/src/styles.css
index 3e34105..3b6ab58 100644
--- a/nurse/src/styles.css
+++ b/nurse/src/styles.css
@@ -330,3 +330,30 @@ small, .muted, .hint { color: var(--mut); }
 .adhoc-sheet .sheet-actions button:first-child { justify-content: space-between; min-height: 56px; border-radius: 999px; background: var(--gold); color: var(--on-gold); }
 .adhoc-sheet .sheet-actions button:first-child span { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--on-gold) 12%, transparent); }
 @media (min-width: 820px) { .adhoc-sheet { width: min(540px, 92%); } }
+
+/* Stage 12: visit detail and active visit. */
+.visit-detail-screen, .active-visit-screen { max-width: 620px; margin-inline: auto; }
+.back-link, .active-back { color: var(--mut); font-size: .85rem; font-weight: 700; text-decoration: none; }
+.visit-detail-heading, .active-visit-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
+.visit-detail-heading h1, .active-visit-heading h1 { margin: 0; font-family: var(--serif); font-size: clamp(1.65rem, 7vw, 2rem); }
+.visit-detail-heading p, .active-visit-heading p { margin: .2rem 0 0; color: var(--mut); }
+.detail-card { padding: 1rem; }
+.detail-card h2 { margin: 0; font-family: var(--sans); font-size: 1rem; }
+.detail-card > p:last-child { margin-bottom: 0; color: var(--ink); }
+.pill-link { display: inline-flex; align-items: center; gap: .45rem; min-height: 42px; margin-top: .8rem; padding: .4rem .55rem .4rem 1rem; border-radius: 999px; background: var(--mint); color: var(--ink); font-weight: 750; text-decoration: none; }
+.pill-link span, .quick-note-action span { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--ink) 8%, transparent); }
+.detail-primary-action button { width: 100%; justify-content: space-between; min-height: 56px; border-radius: 999px; background: var(--gold); color: var(--on-gold); }
+.detail-primary-action button span { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--on-gold) 12%, transparent); }
+.visit-secondary-actions { display: flex; flex-wrap: wrap; gap: .6rem; }
+.visit-secondary-actions a { min-height: 48px; display: inline-flex; align-items: center; padding: .55rem .75rem; font-weight: 750; }
+.active-visit-screen .elapsed-timer { margin: .1rem 0 .45rem; color: var(--forest); font-family: var(--serif); font-size: clamp(3rem, 16vw, 4.1rem); line-height: .95; text-align: center; }
+.active-section { padding: 1rem; }
+.photo-strip { display: flex; gap: .7rem; overflow-x: auto; }
+.photo-thumb, .photo-add { width: 72px; height: 72px; flex: 0 0 72px; display: grid; place-items: center; border-radius: 14px; }
+.photo-thumb { background: repeating-linear-gradient(45deg, var(--straw), var(--straw) 8px, color-mix(in srgb, var(--straw) 65%, var(--bg)) 8px, color-mix(in srgb, var(--straw) 65%, var(--bg)) 16px); color: var(--on-straw); }
+.photo-add { align-content: center; gap: .15rem; border: 1px dashed var(--mut); background: transparent; color: var(--mut); }
+.photo-add span:last-child { font-size: .75rem; }
+.quick-note-input { width: 100%; justify-content: flex-start; min-height: 48px; border: 1px solid var(--line); border-radius: 12px; background: var(--surf); color: var(--mut); font-weight: 400; text-align: left; }
+.quick-note-action { margin-top: .6rem; }
+.active-back { justify-self: center; }
+@media (min-width: 820px) { .visit-detail-screen, .active-visit-screen { margin-inline: 0; } }
