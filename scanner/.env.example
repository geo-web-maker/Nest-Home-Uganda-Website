# Set a DNS name that resolves to this host. Open TCP 80/443 for automatic HTTPS.
SCAN_DOMAIN=scanner.example.test
# Generate with: openssl rand -hex 32
SCAN_BEARER_TOKEN=replace-with-a-long-random-token
# Cloudflare R2 S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
NEST_S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
NEST_S3_BUCKET_MAIL=nest-mail
# Dedicated read-only credentials scoped to the mail attachment prefix.
NEST_S3_READ_KEY=replace-read-only-access-key
NEST_S3_READ_SECRET=replace-read-only-secret-key
SCAN_MAX_BYTES=26214400
